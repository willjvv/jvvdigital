---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | JVV Digital" description="This page could not be found." path="/404">
  <section class="site-container flex min-h-[70vh] items-center py-16">
    <div class="surface-strong mx-auto max-w-2xl p-10 text-center">
      <div class="eyebrow mx-auto">404</div>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-jvv-dark">This page is not here</h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-slate-600">The link may be old or the page may have moved. The main site still has everything you need.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary">Back home</a>
        <a href="/contact" class="btn-secondary">Free review</a>
      </div>
    </div>
  </section>
</Layout>
