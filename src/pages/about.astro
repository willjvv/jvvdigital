---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - JVV Digital">
  <!-- Hero -->
  <section class="pt-20 pb-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">About JVV Digital</h1>
        <p class="text-xl text-gray-600">
          We're on a mission to redefine digital visibility for the AI era, helping small businesses capture qualified leads from both traditional search and emerging AI platforms.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Philosophy -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-6">Our Philosophy</h2>
          <div class="space-y-6">
            <div class="p-6 bg-white rounded-xl">
              <h3 class="text-xl font-bold mb-3 text-jvv-blue">Technical Foundation First</h3>
              <p class="text-gray-600">
                Most SEO efforts fail because they're built on shaky technical foundations. We believe in fixing the core issues before pursuing growth.
              </p>
            </div>
            <div class="p-6 bg-white rounded-xl">
              <h3 class="text-xl font-bold mb-3 text-jvv-orange">AI is the Future of Search</h3>
              <p class="text-gray-600">
                Traditional SEO is evolving. We help businesses prepare for and dominate in AI-powered search environments where their ideal clients are now looking.
              </p>
            </div>
            <div class="p-6 bg-white rounded-xl">
              <h3 class="text-xl font-bold mb-3 text-jvv-blue">Authority Over Algorithms</h3>
              <p class="text-gray-600">
                Instead of chasing algorithm updates, we build genuine authority through valuable content and strategic optimization that stands the test of time.
              </p>
            </div>
          </div>
        </div>
        <div>
          <div class="bg-gradient-to-br from-jvv-blue to-jvv-orange p-1 rounded-2xl">
            <div class="bg-white p-8 rounded-xl">
              <h3 class="text-2xl font-bold mb-6">Why We're Different</h3>
              <div class="space-y-4">
                <div class="flex items-start">
                  <svg class="w-6 h-6 text-jvv-orange mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <div>
                    <h4 class="font-bold mb-1">AI-First Approach</h4>
                    <p class="text-gray-600">We optimize for both traditional search and AI answer engines from day one.</p>
                  </div>
                </div>
                <div class="flex items-start">
                  <svg class="w-6 h-6 text-jvv-blue mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <div>
                    <h4 class="font-bold mb-1">No Black Box Methods</h4>
                    <p class="text-gray-600">Transparent processes and clear reporting on every action we take.</p>
                  </div>
                </div>
                <div class="flex items-start">
                  <svg class="w-6 h-6 text-jvv-orange mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                  <div>
                    <h4 class="font-bold mb-1">Results-Driven Focus</h4>
                    <p class="text-gray-600">Every strategy is designed to drive qualified leads, not just improve vanity metrics.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder/Team Section -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">The Mind Behind JVV Digital</h2>
        <p class="text-gray-600">
          [Founder/Team information placeholder. This is where you'll add your bio, experience, and personal story.]
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto bg-white rounded-2xl p-8 shadow-xl">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="w-32 h-32 gradient-bg rounded-full flex items-center justify-center">
            <span class="text-white text-4xl font-bold">JV</span>
          </div>
          <div class="text-center md:text-left">
            <h3 class="text-2xl font-bold mb-2">Founder & SEO/AI Specialist</h3>
            <p class="text-gray-600 mb-4">
              [Placeholder for founder bio. Example: "With over X years in technical SEO and AI optimization, I founded JVV Digital to help small businesses navigate the changing search landscape. My expertise bridges traditional SEO best practices with emerging AI technologies."]
            </p>
            <div class="flex flex-wrap gap-3 justify-center md:justify-start">
              <span class="px-3 py-1 bg-blue-100 text-jvv-blue rounded-full text-sm">Technical SEO</span>
              <span class="px-3 py-1 bg-orange-100 text-jvv-orange rounded-full text-sm">AI Optimization</span>
              <span class="px-3 py-1 bg-blue-100 text-jvv-blue rounded-full text-sm">Digital Strategy</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">Our Core Values</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          The principles that guide every project and partnership.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="text-center p-8 bg-white rounded-2xl">
          <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Transparency</h3>
          <p class="text-gray-600">
            No hidden processes or secret methods. We explain everything in clear, understandable terms.
          </p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl">
          <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Innovation</h3>
          <p class="text-gray-600">
            Continuously researching and implementing the latest AI and SEO developments for our clients.
          </p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl">
          <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mx-auto mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Partnership</h3>
          <p class="text-gray-600">
            We view our clients as partners and are invested in their long-term success.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-6">Want to Learn More About Our Approach?</h2>
      <p class="text-gray-600 text-lg mb-10 max-w-2xl mx-auto">
        Let's discuss how we can help build your digital authority.
      </p>
      <a 
        href="/contact" 
        class="inline-block bg-jvv-orange text-white px-10 py-4 rounded-xl font-bold text-lg hover:bg-orange-600 transition-all duration-200 transform hover:scale-105 shadow-xl"
      >
        Start the Conversation →
      </a>
    </div>
  </section>
</Layout>