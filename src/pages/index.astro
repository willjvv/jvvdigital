---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';

const title = 'JVV Digital | AI Visibility and Technical SEO';
const description = 'JVV Digital improves technical visibility for how businesses are discovered now, with AI visibility, technical SEO, and strategic website builds.';

const services = [
  {
    eyebrow: 'Foundation',
    title: 'Technical Visibility Foundation',
    description: 'Fix crawlability, structure, schema, speed, and the technical signals that help search engines and AI systems understand a site.',
    bullets: ['Crawl and index review', 'Schema and structured data', 'Site architecture and internal linking', 'Performance and mobile checks'],
    featured: false,
    icon: 'M12 2l3 7h7l-5.6 4.1L18.5 20 12 15.9 5.5 20l1.1-6.9L1 9h7l4-7z'
  },
  {
    eyebrow: 'Strategy',
    title: 'AI plus Search Visibility Strategy',
    description: 'Improve how your business appears across search results, AI summaries, and recommendation engines, then adjust as systems change.',
    bullets: ['AI visibility monitoring', 'Prompt aligned content opportunities', 'Entity and authority reinforcement', 'Clear monthly priorities'],
    featured: true,
    icon: 'M13 10V3L4 14h7v7l9-11h-7z'
  },
  {
    eyebrow: 'Builds',
    title: 'Strategic Website Infrastructure',
    description: 'When the current site limits growth, rebuild only what is necessary or start from scratch with the right foundation.',
    bullets: ['Rebuilds for clarity and speed', 'New sites built for discoverability', 'Conversion focused page structure', 'Technical SEO from day one'],
    featured: false,
    icon: 'M4 6h16M4 12h16M4 18h10'
  }
];
---
<Layout title={title} description={description} path="/">
  <Hero />

  <section class="site-container py-16 md:py-20">
    <SectionHeading
      eyebrow="Why this matters now"
      title="Search behavior changed, and your site has to keep up"
      copy="People still search, but they do not search the same way. AI systems now help shape what gets seen, cited, and remembered, which means structure and clarity matter more than ever."
    />

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="surface-strong p-6">
        <div class="text-sm font-semibold uppercase tracking-[0.18em] text-jvv-orange">Search still matters</div>
        <p class="mt-3 text-sm leading-6 text-slate-600">Google remains foundational, but it is no longer the only place discovery begins.</p>
      </div>
      <div class="surface-strong p-6">
        <div class="text-sm font-semibold uppercase tracking-[0.18em] text-jvv-orange">AI summaries influence decisions</div>
        <p class="mt-3 text-sm leading-6 text-slate-600">More buyers ask AI tools first, then click later, which changes how visibility should be planned.</p>
      </div>
      <div class="surface-strong p-6">
        <div class="text-sm font-semibold uppercase tracking-[0.18em] text-jvv-orange">Structure determines visibility</div>
        <p class="mt-3 text-sm leading-6 text-slate-600">Clear structure helps systems understand what you do, who you help, and why your site should be surfaced.</p>
      </div>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <SectionHeading
      eyebrow="The visibility system"
      title="Three paths, one outcome"
      copy="Every business needs a different starting point. Some need technical cleanup, some need ongoing strategy, and some need a stronger website foundation before growth can really work."
    />

    <div class="mt-10 grid gap-6 xl:grid-cols-3">
      {services.map((service) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          bullets={service.bullets}
          eyebrow={service.eyebrow}
          featured={service.featured}
        >
          <svg slot="icon" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={service.icon} />
          </svg>
        </ServiceCard>
      ))}
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="surface-strong p-8 md:p-10">
        <div class="eyebrow">Founder led</div>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-jvv-dark md:text-4xl">I work directly with clients, not through a big agency layer</h2>
        <p class="mt-5 text-base leading-7 text-slate-600">
          I am Will Johntz Van Voris, the founder of JVV Digital. I started this business because I was fascinated by the new world of marketing for AI and wanted to build something useful, technical, and practical for small businesses that need help making sense of modern discovery.
        </p>
        <p class="mt-4 text-base leading-7 text-slate-600">
          My approach is collaborative and consultative. You tell me what you are trying to achieve, I map the cleanest path forward, and then we refine it together as the work moves forward.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <span class="chip">Curious</span>
          <span class="chip">Practical</span>
          <span class="chip">Reflective</span>
          <span class="chip">Collaborative</span>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="surface p-6">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">When a build is needed</div>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight text-jvv-dark">Strategic website infrastructure</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">If the current site is slow, unclear, or limiting growth, I can rebuild key pages or the full site with the right technical structure from the start.</p>
        </div>
        <div class="surface p-6">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">How I think</div>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight text-jvv-dark">Intent first, always</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">I believe strong marketing starts with intent. The goal is not shortcuts. The goal is to solve the real problem in a way that lasts.</p>
        </div>
        <div class="surface p-6 md:col-span-2">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">No site yet</div>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight text-jvv-dark">That is still a fit</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">Some businesses need visibility strategy. Others need the foundation first. If you do not have a website yet, I can still help you plan the right starting point and avoid building on a weak base.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="surface-dark overflow-hidden p-8 md:p-10">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <div class="eyebrow border-white/10 bg-white/10 text-white/90">Start with a free review</div>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-4xl">If you want a clearer path forward, we can start there</h2>
          <p class="mt-4 max-w-2xl text-base leading-7 text-white/80">
            You do not need to know which service you need before you reach out. Share the basics and I will point you toward the cleanest next step.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <a href="/contact" class="btn-ghost">Request a detailed review</a>
          <a href="/services" class="inline-flex items-center justify-center rounded-2xl border border-white/20 bg-transparent px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">See services in more detail</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
