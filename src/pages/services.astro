---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
---

<Layout title="Services - JVV Digital">
  <!-- Hero -->
  <section class="pt-20 pb-16 bg-gradient-to-b from-white to-gray-50">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Our Strategic Services</h1>
        <p class="text-xl text-gray-600">
          Each service is designed to systematically build your digital authority across both traditional and emerging search platforms.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section id="services-detail" class="py-20">
    <div class="container mx-auto px-6">
      <!-- Technical SEO Audit -->
      <div id="audit" class="mb-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-block px-4 py-1 bg-jvv-blue/10 text-jvv-blue rounded-full text-sm font-semibold mb-4">
              Phase 1: Diagnosis
            </span>
            <h2 class="text-3xl font-bold mb-6">Technical SEO Audit & Fix</h2>
            <p class="text-gray-600 mb-6">
              Many websites suffer from hidden technical issues that silently kill their ranking potential. We perform a comprehensive audit that goes beyond surface-level checks.
            </p>
            <div class="space-y-4">
              <div class="flex items-start">
                <svg class="w-6 h-6 text-jvv-orange mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <div>
                  <h4 class="font-bold mb-1">Performance Analysis</h4>
                  <p class="text-gray-600">Core Web Vitals optimization, server response times, and rendering issues.</p>
                </div>
              </div>
              <div class="flex items-start">
                <svg class="w-6 h-6 text-jvv-orange mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <div>
                  <h4 class="font-bold mb-1">Security & Indexing</h4>
                  <p class="text-gray-600">HTSSL implementation, robots.txt optimization, and crawl budget management.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 p-8 rounded-2xl">
            <ServiceCard
              title="Technical SEO Audit"
              description="Complete technical analysis with prioritized fixes."
              features={[
                "Full site crawl analysis",
                "Performance optimization",
                "Mobile usability fixes",
                "Security enhancements",
                "3-month follow-up support"
              ]}
              price="$1,500 - $3,500"
              ctaText="Get Detailed Proposal"
            />
          </div>
        </div>
      </div>

      <!-- AI Visibility -->
      <div id="ai" class="mb-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="lg:order-2">
            <span class="inline-block px-4 py-1 bg-jvv-orange/10 text-jvv-orange rounded-full text-sm font-semibold mb-4">
              Phase 2: AI Optimization
            </span>
            <h2 class="text-3xl font-bold mb-6">AI Visibility Optimization</h2>
            <p class="text-gray-600 mb-6">
              Traditional SEO is no longer enough. We optimize your content and structure for AI answer engines where your future clients are now searching.
            </p>
            <div class="space-y-4">
              <div class="flex items-start">
                <svg class="w-6 h-6 text-jvv-blue mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
                <div>
                  <h4 class="font-bold mb-1">AI Content Strategy</h4>
                  <p class="text-gray-600">Structuring content for AI comprehension and Q&A optimization.</p>
                </div>
              </div>
              <div class="flex items-start">
                <svg class="w-6 h-6 text-jvv-blue mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                <div>
                  <h4 class="font-bold mb-1">Schema & Markup</h4>
                  <p class="text-gray-600">Advanced structured data for AI crawlers and knowledge graphs.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 p-8 rounded-2xl lg:order-1">
            <ServiceCard
              title="AI Visibility Package"
              description="Optimize for ChatGPT, Perplexity, and emerging AI search."
              features={[
                "AI visibility audit",
                "Content restructuring",
                "Q&A page development",
                "Schema optimization",
                "AI tool monitoring setup"
              ]}
              price="Custom Quote"
              ctaText="Discuss AI Strategy"
              highlighted={true}
            />
          </div>
        </div>
      </div>

      <!-- Ongoing SEO -->
      <div id="ongoing">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-block px-4 py-1 bg-jvv-blue/10 text-jvv-blue rounded-full text-sm font-semibold mb-4">
              Phase 3: Authority Building
            </span>
            <h2 class="text-3xl font-bold mb-6">Ongoing SEO Authority</h2>
            <p class="text-gray-600 mb-6">
              Sustainable growth requires consistent effort. Our monthly retainer ensures your visibility grows across all platforms.
            </p>
            <div class="space-y-4">
              <div class="flex items-start">
                <svg class="w-6 h-6 text-jvv-orange mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <div>
                  <h4 class="font-bold mb-1">Comprehensive Monitoring</h4>
                  <p class="text-gray-600">Track rankings across Google and AI platforms with detailed analytics.</p>
                </div>
              </div>
              <div class="flex items-start">
                <svg class="w-6 h-6 text-jvv-orange mr-3 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <div>
                  <h4 class="font-bold mb-1">Strategic Content Development</h4>
                  <p class="text-gray-600">Regular content creation optimized for both humans and AI.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 p-8 rounded-2xl">
            <ServiceCard
              title="Ongoing Authority Package"
              description="Monthly SEO management for sustained growth."
              features={[
                "Monthly strategy sessions",
                "Content creation (2-4 pieces/month)",
                "Link building outreach",
                "AI & Google ranking reports",
                "Priority technical support"
              ]}
              price="$800 - $2,500/month"
              ctaText="Start Partnership"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">Our 3-Phase Process</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          A systematic approach to building lasting digital authority.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="text-center p-8 bg-white rounded-2xl">
          <div class="w-16 h-16 gradient-bg rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-white text-2xl font-bold">1</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Diagnose</h3>
          <p class="text-gray-600">
            Comprehensive technical audit to identify all issues preventing growth.
          </p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl">
          <div class="w-16 h-16 gradient-bg rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-white text-2xl font-bold">2</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Optimize</h3>
          <p class="text-gray-600">
            Fix technical issues and optimize for both Google and AI platforms.
          </p>
        </div>
        <div class="text-center p-8 bg-white rounded-2xl">
          <div class="w-16 h-16 gradient-bg rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-white text-2xl font-bold">3</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Grow</h3>
          <p class="text-gray-600">
            Ongoing authority building through content and strategic partnerships.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-6">Ready to Transform Your Visibility?</h2>
      <p class="text-gray-600 text-lg mb-10 max-w-2xl mx-auto">
        Let's discuss which service is right for your business goals.
      </p>
      <a 
        href="/contact" 
        class="inline-block bg-jvv-orange text-white px-10 py-4 rounded-xl font-bold text-lg hover:bg-orange-600 transition-all duration-200 transform hover:scale-105 shadow-xl"
      >
        Schedule Free Consultation →
      </a>
    </div>
  </section>
</Layout>