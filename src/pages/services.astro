---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const title = 'Services | JVV Digital';
const description = 'Technical visibility foundation, AI and search visibility strategy, and strategic website infrastructure from JVV Digital.';

const serviceSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Technical Visibility Foundation',
    serviceType: 'Technical SEO and discoverability optimization',
    provider: { '@type': 'Organization', name: 'JVV Digital' },
    areaServed: 'United States'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'AI plus Search Visibility Strategy',
    serviceType: 'AI visibility strategy and ongoing optimization',
    provider: { '@type': 'Organization', name: 'JVV Digital' },
    areaServed: 'United States'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Strategic Website Infrastructure',
    serviceType: 'Website rebuilds and technical website development',
    provider: { '@type': 'Organization', name: 'JVV Digital' },
    areaServed: 'United States'
  }
];
---
<Layout title={title} description={description} path="/services" structuredData={serviceSchema}>
  <section class="site-container pt-12 md:pt-16">
    <div class="max-w-4xl">
      <div class="eyebrow">Services</div>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-jvv-dark md:text-6xl">Three paths to technical visibility and AI-ready discovery</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
        Some businesses need structural fixes, some need ongoing AI visibility strategy, and some need a website rebuild to unlock growth. JVV Digital helps you determine the right path instead of forcing a generic package.
      </p>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="surface-strong p-8 md:p-10">
        <div class="eyebrow">Path 1</div>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-jvv-dark">Technical Visibility Foundation</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Fix structural issues that prevent search engines and AI systems from understanding and properly ranking your site. This is the first step when the foundation needs work.
        </p>
        <ul class="mt-6 space-y-3 text-sm leading-6 text-slate-700">
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>Crawlability and index optimization</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>Schema and structured data</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>Site architecture and internal linking</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>Speed, mobile, and technical health checks</span></li>
        </ul>
      </div>

      <div class="surface p-8 md:p-10">
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">What this does</div>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-jvv-dark">Makes the site easier to understand</h3>
        <p class="mt-4 text-base leading-7 text-slate-600">
          The result is a site that gives modern search systems fewer reasons to hesitate and more reasons to trust what it is seeing.
        </p>
        <div class="mt-6 rounded-[1.5rem] bg-slate-50 p-5 text-sm leading-6 text-slate-600">
          Technical clarity first, then growth.
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div class="surface p-8 md:p-10 lg:order-2">
        <div class="eyebrow">Path 2</div>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-jvv-dark">AI plus Search Visibility Strategy</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Track how your business appears across search engines and AI-driven recommendation systems, then adjust strategically as those systems change.
        </p>
        <ul class="mt-6 space-y-3 text-sm leading-6 text-slate-700">
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-blue"></span><span>AI visibility monitoring</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-blue"></span><span>Prompt aligned content opportunities</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-blue"></span><span>Entity and authority reinforcement</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-blue"></span><span>Monthly priorities and practical adjustments</span></li>
        </ul>
      </div>

      <div class="surface-strong p-8 md:p-10 lg:order-1">
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">What this does</div>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-jvv-dark">Keeps visibility current</h3>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Search and AI systems keep evolving. Ongoing strategy helps your business stay visible instead of drifting out of view as the landscape shifts.
        </p>
        <div class="mt-6 rounded-[1.5rem] bg-slate-50 p-5 text-sm leading-6 text-slate-600">
          Built for businesses that already know attention matters.
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="surface-strong p-8 md:p-10">
        <div class="eyebrow">Path 3</div>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-jvv-dark">Strategic Website Infrastructure</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          When the current site limits growth, I can rebuild only what is necessary or create a new site from the ground up with the right technical foundation from the start.
        </p>
        <ul class="mt-6 space-y-3 text-sm leading-6 text-slate-700">
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>Rebuilds for clarity and speed</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>New sites built for discoverability</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>Conversion focused page structure</span></li>
          <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-jvv-orange"></span><span>Technical SEO from day one</span></li>
        </ul>
      </div>

      <div class="surface p-8 md:p-10">
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">What this does</div>
        <h3 class="mt-4 text-2xl font-semibold tracking-tight text-jvv-dark">Builds the right starting point</h3>
        <p class="mt-4 text-base leading-7 text-slate-600">
          If a site is slowing growth before it even starts, rebuilding can be the cleaner path. The goal is not a prettier site, it is a site that can actually support the business.
        </p>
        <div class="mt-6 rounded-[1.5rem] bg-slate-50 p-5 text-sm leading-6 text-slate-600">
          Good infrastructure makes every future marketing move easier.
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <SectionHeading
      eyebrow="Flexible expansion"
      title="Add-ons only when they make sense"
      copy="Every project is different, so the work can expand in the direction that best supports the business instead of forcing a preset menu."
      center
    />

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="surface-strong p-6">
        <div class="text-sm font-semibold uppercase tracking-[0.18em] text-jvv-orange">Content support</div>
        <p class="mt-3 text-sm leading-6 text-slate-600">Content creation aligned with AI visibility and the questions people are actually asking.</p>
      </div>
      <div class="surface-strong p-6">
        <div class="text-sm font-semibold uppercase tracking-[0.18em] text-jvv-orange">Tracking</div>
        <p class="mt-3 text-sm leading-6 text-slate-600">Better measurement so decisions are based on what the site is doing, not guesswork.</p>
      </div>
      <div class="surface-strong p-6">
        <div class="text-sm font-semibold uppercase tracking-[0.18em] text-jvv-orange">Implementation support</div>
        <p class="mt-3 text-sm leading-6 text-slate-600">Guidance for teams that want the plan and need help turning it into finished work.</p>
      </div>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="surface p-8 md:p-10">
      <SectionHeading
        eyebrow="How it works"
        title="A simple process that keeps the work grounded"
        copy="The goal is to make the path clear, reduce guesswork, and focus on the most useful move first."
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-[1.5rem] bg-slate-50 p-6">
          <div class="text-4xl font-semibold text-jvv-blue">1</div>
          <h3 class="mt-4 text-xl font-semibold text-jvv-dark">Review</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">I analyze the current site, or the planned site if you are starting from scratch.</p>
        </div>
        <div class="rounded-[1.5rem] bg-slate-50 p-6">
          <div class="text-4xl font-semibold text-jvv-orange">2</div>
          <h3 class="mt-4 text-xl font-semibold text-jvv-dark">Prioritize</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">I identify the technical fixes, strategy adjustments, and structural choices that matter most.</p>
        </div>
        <div class="rounded-[1.5rem] bg-slate-50 p-6">
          <div class="text-4xl font-semibold text-jvv-blue">3</div>
          <h3 class="mt-4 text-xl font-semibold text-jvv-dark">Implement and refine</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">I make the plan real, measure the results, and adjust based on what the work actually shows.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="surface-dark overflow-hidden p-8 md:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
        <div>
          <div class="eyebrow border-white/10 bg-white/10 text-white/90">Ready when you are</div>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-4xl">Start with a free review, then decide what is worth doing</h2>
          <p class="mt-4 max-w-2xl text-base leading-7 text-white/80">
            You do not need to arrive knowing the exact service you need. Share the basics, and I will point you toward the cleanest next step.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <a href="/contact" class="btn-ghost">Request your free review</a>
          <a href="/about" class="inline-flex items-center justify-center rounded-2xl border border-white/20 bg-transparent px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Meet the founder</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
