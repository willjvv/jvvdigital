---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DetailedReviewForm from '../components/DetailedReviewForm.astro';

const title = 'Free Review | JVV Digital';
const description = 'Request a free visibility review from JVV Digital. Share your website or planned domain and get practical next steps.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does the review take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You will get a response after the review is completed, usually within a few business days.'
      }
    },
    {
      '@type': 'Question',
      name: 'Do I need an existing website?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. You can share a planned domain if you are still early in the process.'
      }
    },
    {
      '@type': 'Question',
      name: 'Is there any obligation after I submit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The review is meant to help you understand the next step, not force a commitment.'
      }
    },
    {
      '@type': 'Question',
      name: 'What do I receive?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You will get practical feedback on technical issues, AI visibility gaps, and the most sensible next move.'
      }
    }
  ]
};
---
<Layout title={title} description={description} path="/contact" structuredData={faqSchema}>
  <section class="site-container pt-12 md:pt-16">
    <div class="max-w-4xl">
      <div class="eyebrow">Free review</div>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-jvv-dark md:text-6xl">Start your free visibility review</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
        Send the basics, and I will review your current website or planned domain for technical SEO and AI visibility opportunities. You will get practical feedback and a clear next step, with no obligation.
      </p>
    </div>
  </section>

  <section class="site-container py-16 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[1fr_0.95fr] lg:items-start">
      <DetailedReviewForm />

      <div class="space-y-6">
        <div class="surface-dark p-8 md:p-10">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-white/80">What you will receive</div>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white">A practical look at what is helping or holding back visibility</h2>
          <ul class="mt-6 space-y-4 text-sm leading-6 text-white/80">
            <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-white"></span><span>Technical issues that affect crawlability, structure, and speed</span></li>
            <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-white"></span><span>AI visibility gaps that may keep your business out of answer engines</span></li>
            <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-white"></span><span>Clear next steps so you can decide what is worth doing next</span></li>
          </ul>
        </div>

        <div class="surface-strong p-8 md:p-10">
          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">Low pressure, direct process</div>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Submitting this form does not commit you to anything. It simply gives me enough context to respond with a useful first look and a more grounded recommendation.
          </p>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Every review is handled directly by JVV Digital, which keeps the process personal, practical, and easy to follow.
          </p>
        </div>

        <div class="surface p-8 md:p-10">
          <SectionHeading eyebrow="Frequently asked" title="A few quick answers" />
          <div class="mt-6 space-y-5">
            <details class="rounded-[1.25rem] border border-slate-200 bg-white p-5">
              <summary class="cursor-pointer list-none text-sm font-semibold text-jvv-dark">How soon will I hear back?</summary>
              <p class="mt-3 text-sm leading-6 text-slate-600">Usually within a few business days after I review the details you send.</p>
            </details>
            <details class="rounded-[1.25rem] border border-slate-200 bg-white p-5">
              <summary class="cursor-pointer list-none text-sm font-semibold text-jvv-dark">Do I need to know which service I need?</summary>
              <p class="mt-3 text-sm leading-6 text-slate-600">No. Share the situation as best you can and I will help sort out the right next step.</p>
            </details>
            <details class="rounded-[1.25rem] border border-slate-200 bg-white p-5">
              <summary class="cursor-pointer list-none text-sm font-semibold text-jvv-dark">What if I do not have a live site yet?</summary>
              <p class="mt-3 text-sm leading-6 text-slate-600">That is fine. Use your planned domain and tell me where you are in the process.</p>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-container pb-16 md:pb-20">
    <div class="surface-strong p-8 md:p-10 text-center">
      <div class="eyebrow">Ready to begin</div>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-jvv-dark md:text-4xl">Let's start with the simplest version of the conversation</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600">
        If the goal is clearer visibility, a practical review is the easiest place to start. Share what you have, and I will help identify the next useful move.
      </p>
      <div class="mt-8 flex justify-center">
        <a href="#" class="btn-primary">Request My Free Review</a>
      </div>
    </div>
  </section>
</Layout>
