---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = '/',
  structuredData
} = Astro.props;

const siteUrl = 'https://jvvdigital.com';
const canonical = `${siteUrl}${path === '/' ? '/' : path.replace(/\/$/, '')}`;
const dataList = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'JVV Digital',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  image: `${siteUrl}/og-image.svg`,
  description: description,
  address: {
    '@type': 'PostalAddress',
    'addressLocality': 'New York',
    'addressRegion': 'NY',
    'addressCountry': 'US'
  },
  // This tells AI specifically what topics you are an authority on
  knowsAbout: [
    "Technical SEO",
    "AI Visibility",
    "Schema Markup",
    "Structured Data",
    "Web Development",
    "Astro Framework"
  ],
  founder: {
    '@type': 'Person',
    'name': 'Will Johntz Van Voris',
    'jobTitle': 'Founder & Technical Consultant',
    'sameAs': [
      'https://www.linkedin.com/in/willjvv',
      'https://github.com/willjvv'
    ]
  },
  sameAs: [
    'https://www.linkedin.com/company/jvvdigital'
  ]
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'JVV Digital',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0F172A" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JVV Digital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />
    
    {/* Combined Global Schema */}
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}></script>
    
    {/* Page-Specific Schema (e.g., Services, BlogPosts) */}
    {dataList.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
  </head>
  <body class="min-h-screen text-jvv-dark bg-white">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>