---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' }
];
---
<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-xl">
  <div class="site-container">
    <div class="flex items-center justify-between py-4">
      <a href="/" class="flex items-center gap-3" aria-label="JVV Digital home">
        <img src="/logo.png" alt="JVV Digital" class="h-20 w-auto rounded-xl shadow-sm" />
        <div class="leading-tight">
          <div class="text-[0.95rem] font-semibold tracking-tight text-jvv-dark">JVV Digital</div>
          <div class="text-xs text-slate-500">Technical visibility for modern search</div>
        </div>
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-slate-600 transition hover:text-jvv-blue">{item.label}</a>
        ))}
        <a href="/contact" class="btn-primary">Free Review</a>
      </nav>

      <button
        id="menu-button"
        class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white p-3 text-slate-700 shadow-sm md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
        type="button"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden pb-4 md:hidden">
      <div class="surface p-4">
        <nav class="flex flex-col gap-1" aria-label="Mobile">
          {nav.map((item) => (
            <a href={item.href} class="rounded-2xl px-3 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-jvv-blue">{item.label}</a>
          ))}
          <a href="/contact" class="mt-2 btn-primary w-full">Free Review</a>
        </nav>
      </div>
    </div>
  </div>

  <script is:inline>
    const button = document.getElementById('menu-button');
    const menu = document.getElementById('mobile-menu');
    if (button && menu) {
      button.addEventListener('click', () => {
        const isHidden = menu.classList.toggle('hidden');
        button.setAttribute('aria-expanded', String(!isHidden));
      });
    }
  </script>
</header>
