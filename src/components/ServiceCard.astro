---
interface Props {
  title: string;
  description: string;
  bullets: string[];
  eyebrow?: string;
  featured?: boolean;
  href?: string;
  ctaText?: string;
}

const {
  title,
  description,
  bullets,
  eyebrow,
  featured = false,
  href = '/contact',
  ctaText = 'Request a free review'
} = Astro.props;
---
<article class:list={[
  'surface-strong flex h-full flex-col p-7 transition duration-200 hover:-translate-y-1',
  featured ? 'border-jvv-blue/30 shadow-glowBlue' : 'border-slate-200'
]}>
  <div class="mb-5 flex items-center justify-between gap-4">
    <div>
      {eyebrow && <div class="text-xs font-semibold uppercase tracking-[0.18em] text-jvv-orange">{eyebrow}</div>}
      <h3 class="mt-2 text-2xl font-semibold tracking-tight text-jvv-dark">{title}</h3>
    </div>
    <div class:list={[
      'flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl',
      featured ? 'bg-jvv-blue text-white' : 'bg-slate-100 text-jvv-blue'
    ]}>
      <slot name="icon" />
    </div>
  </div>

  <p class="text-sm leading-6 text-slate-600">{description}</p>

  <ul class="mt-6 space-y-3 text-sm text-slate-700">
    {bullets.map((item) => (
      <li class="flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-jvv-orange" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4.5 10.2 8.1 13.8 15.5 6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>

  <div class="mt-8 pt-5">
    <a class={featured ? 'btn-primary w-full' : 'btn-secondary w-full'} href={href}>{ctaText}</a>
  </div>
</article>
