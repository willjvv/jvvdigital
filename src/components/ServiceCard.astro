---
interface Props {
  title: string;
  description: string;
  features: string[];
  price?: string;
  ctaText?: string;
  highlighted?: boolean;
  compact?: boolean;
}

const { title, description, features, price, ctaText = "Learn More", highlighted = false, compact = false } = Astro.props;
---

<div class={`bg-white rounded-2xl h-full flex flex-col ${compact ? 'p-6' : 'p-8'} ${highlighted ? 'border-2 border-jvv-orange shadow-xl' : 'border border-gray-200 shadow-lg'}`}>
  <div class="mb-6">
    {!compact && (
      <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-4 text-white">
        <slot name="icon">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </slot>
      </div>
    )}
    <h3 class={`${compact ? 'text-xl' : 'text-2xl'} font-bold text-gray-900 mb-3`}>{title}</h3>
    <p class="text-gray-600 mb-6">{description}</p>
  </div>
  
  <ul class="space-y-3 mb-8 flex-grow">
    {features.map((feature) => (
      <li class="flex items-start">
        <svg class="w-5 h-5 text-jvv-orange mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-gray-700 text-sm">{feature}</span>
      </li>
    ))}
  </ul>
  
  <a 
    href="/contact" 
    class={`block text-center rounded-lg font-semibold transition-colors duration-200 ${
      compact ? 'py-2 px-4 text-sm' : 'py-3 px-6'
    } ${
      highlighted 
        ? 'bg-jvv-orange text-white hover:bg-orange-600' 
        : 'bg-jvv-blue text-white hover:bg-blue-700'
    }`}
  >
    {ctaText}
  </a>
</div>